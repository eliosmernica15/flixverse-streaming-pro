# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Firebase App Check (optional — enables request validation)
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_KEY=your_recaptcha_key_here

# TMDB Configuration
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Server-only TMDB key (used by /api/tmdb proxy — does NOT start with NEXT_PUBLIC_)
# TMDB_API_KEY=your_tmdb_api_key_here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Sentry (optional — error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/project_id
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (optional — PostHog or GA4)
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Stripe Billing (optional — enables paid plans)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STANDARD_MONTHLY=price_...
# STRIPE_PRICE_STANDARD_YEARLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...

# Firebase Admin (server-only — required for Stripe webhook → Firestore sync)
# Option A: paste full service account JSON (single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option B: individual fields
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate Limiting (optional — production uses @upstash/ratelimit)
# UPSTASH_REDIS_REST_URL=https://your-redis-url
# UPSTASH_REDIS_REST_TOKEN=your_redis_token
