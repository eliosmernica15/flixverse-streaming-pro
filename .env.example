# Python API (Vercel serverless — Postgres, no Firestore quota for social/party)
NEXT_PUBLIC_USE_PYTHON_API=true
PYTHON_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYTHON_WS_URL=ws://127.0.0.1:8000
# Production (Vercel): Python runs at /api/flixverse — no extra URL needed.
# Set POSTGRES_URL via Vercel Postgres storage (required for prod persistence).
# FIREBASE_SERVICE_ACCOUNT_JSON and FIREBASE_PROJECT_ID required on Vercel.

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Firebase App Check (optional — enables request validation)
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_KEY=your_recaptcha_enterprise_key
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_V3_KEY=your_recaptcha_v3_site_key

# TMDB — prefer server-only keys (used by /api/tmdb). Client should not need NEXT_PUBLIC_TMDB_*.
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
# TMDB_API_KEY=your_tmdb_api_key_here
# Legacy fallback (inlined in the client bundle — migrate off these):
# NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
# NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Sentry (optional — error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/project_id
# SENTRY_DSN=https://your_dsn@sentry.io/project_id
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (optional — PostHog or GA4)
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Stripe Billing (optional — enables paid plans)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STANDARD_MONTHLY=price_...
# STRIPE_PRICE_STANDARD_YEARLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...

# Firebase Admin (server-only — required for billing webhooks, account APIs, Python workers)
# Option A: paste full service account JSON (single line) — see Downloads key from Firebase Console
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"streaming-web-2272d",...}
# Option B: path to JSON file (Python workers + optional local dev)
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Admin\Downloads\streaming-web-2272d-firebase-adminsdk-....json
# Option C: individual fields
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate Limiting (optional — production uses @upstash/ratelimit)
# UPSTASH_REDIS_REST_URL=https://your-redis-url
# UPSTASH_REDIS_REST_TOKEN=your_redis_token

# WebRTC TURN (optional — improves NAT traversal for FlixParty)
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=user
# NEXT_PUBLIC_TURN_CREDENTIAL=pass

# Ably — real-time party sync (free tier: 200 concurrent, 6M msgs/month)
# Get key at https://ably.com → Apps → API Keys → copy the root key
NEXT_PUBLIC_ABLY_API_KEY=your_ably_api_key_here

# PostHog host (optional)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
