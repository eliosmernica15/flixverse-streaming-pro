legacy-peer-deps=true

# Pre-approve install scripts so Vercel can cache native-build outputs
# (sharp, esbuild, @swc/core, @parcel/watcher, etc.) across deploys
# instead of re-running node-gyp / postinstall every time.
# Syntax: bare package names, no version, no script name.
# First build still slow (~6-7 min) while native binaries compile;
# subsequent builds hit the cache and skip the recompile.
allow-scripts[]=@firebase/util
allow-scripts[]=@parcel/watcher
allow-scripts[]=@sentry/cli
allow-scripts[]=@swc/core
allow-scripts[]=core-js
allow-scripts[]=esbuild
allow-scripts[]=protobufjs
allow-scripts[]=sharp
allow-scripts[]=unrs-resolver
