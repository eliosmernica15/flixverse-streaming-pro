legacy-peer-deps=true

# Pre-approve install scripts so Vercel can cache native-build outputs
# (sharp, esbuild, @swc/core, @parcel/watcher, etc.) across deploys
# instead of re-running node-gyp / postinstall every time.
# This is the difference between an 8-min build and a ~1-min build.
enable-pre-post-scripts=true
allow-scripts[]=@firebase/util@1.13.0:postinstall
allow-scripts[]=@firebase/util@1.15.1:postinstall
allow-scripts[]=@parcel/watcher@2.5.6:install
allow-scripts[]=@sentry/cli@2.58.6:postinstall
allow-scripts[]=@swc/core@1.15.43:postinstall
allow-scripts[]=core-js@3.49.0:postinstall
allow-scripts[]=esbuild@0.25.0:postinstall
allow-scripts[]=protobufjs@7.6.5:postinstall
allow-scripts[]=sharp@0.34.5:install
allow-scripts[]=unrs-resolver@1.11.1:postinstall
