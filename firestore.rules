rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: field exists and is the correct type
    function hasString(field) {
      return field is string && field.size() > 0;
    }

    // Helper: timestamp is a valid number
    function isTimestamp(field) {
      return field is number && field > 0;
    }

    // Helper: user is in FlixParty participantIds array
    function isInParticipantIds(ids) {
      return isAuthenticated() && request.auth.uid in ids;
    }

    function partyRoom(roomId) {
      return get(/databases/$(database)/documents/flix_parties/$(roomId)).data;
    }

    function isPartyParticipant(roomId) {
      return isAuthenticated() && request.auth.uid in partyRoom(roomId).participantIds;
    }

    function isPartyHost(roomId) {
      return isAuthenticated() && request.auth.uid == partyRoom(roomId).hostId;
    }

    function isFriendRequestForCurrentUser(requestId, users) {
      return exists(/databases/$(database)/documents/friend_requests/$(requestId))
        && get(/databases/$(database)/documents/friend_requests/$(requestId)).data.toUserId == request.auth.uid
        && get(/databases/$(database)/documents/friend_requests/$(requestId)).data.status == 'pending'
        && get(/databases/$(database)/documents/friend_requests/$(requestId)).data.fromUserId in users
        && get(/databases/$(database)/documents/friend_requests/$(requestId)).data.fromUserId != request.auth.uid;
    }

    function canAddPartyParticipant(roomId) {
      let newParticipants = request.resource.data.participants;
      let previousParticipants = resource.data.participants;
      let newIds = request.resource.data.participantIds;
      let previousIds = resource.data.participantIds;
      return !(request.auth.uid in previousIds)
        && request.auth.uid in newIds
        && newParticipants is list
        && newParticipants.size() == previousParticipants.size() + 1
        && newParticipants.hasAll(previousParticipants)
        && newParticipants[newParticipants.size() - 1].userId == request.auth.uid
        && newParticipants[newParticipants.size() - 1].role == 'guest'
        && newIds is list
        && newIds.size() == previousIds.size() + 1
        && newIds.hasAll(previousIds)
        && newIds[newIds.size() - 1] == request.auth.uid;
    }

    function canLeaveParty(roomId) {
      let newParticipants = request.resource.data.participants;
      let previousParticipants = resource.data.participants;
      let newIds = request.resource.data.participantIds;
      let previousIds = resource.data.participantIds;
      return request.auth.uid in previousIds
        && !(request.auth.uid in newIds)
        && newParticipants is list
        && newParticipants.size() == previousParticipants.size() - 1
        && previousParticipants.hasAll(newParticipants)
        && newIds is list
        && newIds.size() == previousIds.size() - 1
        && previousIds.hasAll(newIds);
    }

    // Check if the user is only modifying the pendingQueue field
    // Allows adding suggestions, voting, or removing own suggestions
    function canModifyQueue(roomId) {
      let newQueue = request.resource.data.pendingQueue;
      let previousQueue = resource.data.pendingQueue;

      // Queue must be a list
      if (!(newQueue is list) || !(previousQueue is list)) return false;

      // Must be a participant
      if (!(request.auth.uid in resource.data.participantIds)) return false;

      // Allow if queue size increased by 1 (new suggestion) and user is the suggester
      if (newQueue.size() == previousQueue.size() + 1) {
        let newItem = newQueue[newQueue.size() - 1];
        return newItem.suggestedBy == request.auth.uid
          && newItem.votes is list
          && newItem.votes.size() == 1
          && newItem.votes[0] == request.auth.uid
          && newItem.voteCount == 1;
      }

      // Allow if queue size same (vote toggle or host confirm)
      if (newQueue.size() == previousQueue.size()) {
        // Simplified: check if only voteCount or confirmed changed for one item
        // and the user is the voter (for vote) or host (for confirm)
        let diffCount = 0;
        let voterOrHost = false;

        // Iterate through new queue and compare with previous
        // We can't easily loop, so we check if the overall structure is valid
        // This is a simplified check - in practice, we rely on the client to send valid updates

        // For vote: user's vote status changed (added or removed)
        // For confirm: host set confirmed=true
        return true; // Simplified: trust the client for vote/confirm, host can always modify
      }

      // Allow if queue size decreased by 1 (item removed)
      // Only host or the suggester can remove
      if (newQueue.size() == previousQueue.size() - 1) {
        // Simplified: allow host or any participant to remove (we validate server-side in hook)
        return request.auth.uid == resource.data.hostId; // Only host can remove for now
      }

      return false;
    }

    // Default deny — no match rule = no access
    // (Firestore deny-by-default when no rule matches)

    // User profiles - users can read any profile, write only their own
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && hasString(request.resource.data.display_name);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Unique username index — doc id is normalized handle
    match /usernames/{handle} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.updatedAt is number;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    
    // User movie lists - users can only access their own movie list
    match /user_movie_lists/{docId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.movie_id is number
        && request.resource.data.movie_title is string;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id;
    }

    // Reviews - anyone can read, authenticated users can write their own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.content_id is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.review_text is string
        && request.resource.data.review_text.size() <= 5000;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.user_id
        // Only allow updating review_text, rating, updated_at
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['review_text', 'rating', 'updated_at', 'likes_count'])
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Comments - anyone can read, authenticated users can write their own
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'likes_count', 'updated_at']);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Likes - users can manage their own likes; like history is private.
    match /likes/{likeId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.target_type in ['review', 'comment', 'content'];
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Review likes - users can manage their own review likes; like history is private.
    match /review_likes/{likeId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.user_id;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Content ratings - users can manage their own ratings
    match /content_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.user_id
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Follows - users can manage their own follows
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.follower_id
        && request.resource.data.follower_id != request.resource.data.following_id;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.follower_id;
    }

    // Watch history - users can only access their own history
    match /watch_history/{historyId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.content_id is number
        && request.resource.data.progress_seconds is number;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow delete: if false; // watch history is never deleted via client
    }

    // Notifications — recipients manage their inbox; creation is server-only.
    // Clients may only mark their own item read or set the invite response flag.
    match /notifications/{notificationId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.user_id
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'data'])
        && request.resource.data.read is bool
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['data'])
          || (
            request.resource.data.data is map
            && resource.data.data is map
            && request.resource.data.data.diff(resource.data.data).affectedKeys()
                .hasOnly(['invite_status'])
            && request.resource.data.data.invite_status in ['accepted', 'declined']
          )
        );
      allow create: if false;
    }

    // Activity feed is generated by trusted workers from verified user actions.
    match /activity_feed/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // ── FlixParty ──────────────────────────────────────────────
    match /flix_parties/{roomId} {
      // Room ids in invite URLs are unguessable bearer capabilities. List queries
      // are intentionally disabled; code discovery uses flix_party_codes.
      allow get: if isAuthenticated();
      allow list: if false;

      allow update: if isAuthenticated() && (
        request.resource.data.hostId is string
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() > 0
        && request.resource.data.participantIds.size() <= 20
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == request.resource.data.participantIds.size()
        && (
        // The host controls playback, room policy, moderation, and host transfer.
        (
          request.auth.uid == resource.data.hostId
          && (
            request.resource.data.hostId == resource.data.hostId
            || request.resource.data.hostId in request.resource.data.participantIds
          )
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'playbackState', 'lastKnownTime', 'serverIndex', 'updatedAt',
                'encryptedPayload', 'contentMeta', 'controlsMode',
                'hostId', 'participants', 'participantIds',
                'hostSeq', 'hostSeqAt',
                'pendingQueue'
              ])
        )
        || (
          // Non-host members can only join, leave, refresh presence, or modify the queue.
          request.resource.data.hostId == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantIds', 'updatedAt', 'pendingQueue'])
          && (canAddPartyParticipant(roomId) || canLeaveParty(roomId) || canModifyQueue(roomId))
        )
        )
      );
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.hostId
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 1
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.participants[0].userId == request.auth.uid
        && request.resource.data.participants[0].role == 'host';
      allow delete: if isPartyHost(roomId);

      match /messages/{messageId} {
        allow read: if isPartyParticipant(roomId);
        allow create: if isPartyParticipant(roomId)
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.senderId is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if isPartyParticipant(roomId);
        allow create: if isPartyParticipant(roomId)
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.type in ['play', 'pause', 'seek', 'heartbeat', 'speaking', 'server-change', 'sync-stage', 'sync-go', 'guest-control']
          && (
            isPartyHost(roomId)
            || (
              request.resource.data.type == 'guest-control'
              && partyRoom(roomId).controlsMode == 'COLLABORATIVE'
              && request.resource.data.data is map
              && request.resource.data.data.action in ['play', 'pause', 'seek', 'server-change']
            )
          );
        allow update: if eventId == 'heartbeat'
          && isPartyParticipant(roomId)
          && isPartyHost(roomId)
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.type == 'heartbeat';
        allow delete: if isPartyHost(roomId);
      }

      match /signals/{signalId} {
        allow read: if isPartyParticipant(roomId);
        allow create: if isPartyParticipant(roomId)
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.type in ['offer', 'answer', 'candidate']
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && request.resource.data.targetId.size() <= 128
          && request.resource.data.targetId != request.auth.uid
          && request.resource.data.targetId in partyRoom(roomId).participantIds;
        allow delete: if isPartyParticipant(roomId)
          && (request.auth.uid == resource.data.senderId
              || request.auth.uid == resource.data.targetId);
        allow update: if false;
      }
    }

    // ── Timeline Comments ──────────────────────────────────────
    match /timeline_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.tmdbId is number
        && request.resource.data.timestampSeconds is number
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      // Only owner can update (likes) or delete
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'status', 'updatedAt']);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ── Reports (moderation) ───────────────────────────────────
    // Reports are private to trusted server workers (Admin SDK bypasses rules).
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.targetType in ['review', 'comment', 'timeline_comment', 'profile']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && hasString(request.resource.data.reason)
        && request.resource.data.reason.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && (!('details' in request.resource.data) || request.resource.data.details == null || (request.resource.data.details is string && request.resource.data.details.size() <= 2000))
        && (!('targetOwnerId' in request.resource.data) || request.resource.data.targetOwnerId == null || request.resource.data.targetOwnerId is string);
      allow update: if false; // only admin Cloud Functions update reports
      allow delete: if false;
    }

    // ── Friendships ───────────────────────────────────────────
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.users;
      // An accepted friendship must correspond to a pending request addressed
      // to the caller; clients cannot manufacture relationships unilaterally.
      allow create: if isAuthenticated()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'accepted'
        && isFriendRequestForCurrentUser(
          request.resource.data.users[0] == request.auth.uid
            ? request.resource.data.users[1]
            : request.resource.data.users[0],
          request.resource.data.users
        );
      // The current client only creates and removes friendship records.
      allow update: if false;
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.users;
    }

    // ── Friend Requests ───────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId is string
        && request.auth.uid != request.resource.data.toUserId
        && request.resource.data.status == 'pending';
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow update: if false; // requests are deleted, not updated
    }

    // ── Subscriptions (Stripe billing) — read-only for clients; writes via Admin SDK
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Pending jobs (client enqueues, Python worker / API processes — Spark-safe)
    match /pending_jobs/{jobId} {
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.requestedBy
        && request.resource.data.status == 'pending'
        && request.resource.data.payload is map
        && request.resource.data.keys().hasOnly(['type', 'status', 'requestedBy', 'payload', 'createdAt'])
        && request.resource.data.createdAt is number
        && (
          (
            request.resource.data.type == 'follow_notify'
            && request.resource.data.payload.fromUserId == request.auth.uid
            && hasString(request.resource.data.payload.toUserId)
            && request.resource.data.payload.toUserId != request.auth.uid
          )
          || (
            request.resource.data.type == 'activity_review'
            && request.resource.data.payload.userId == request.auth.uid
            && request.resource.data.payload.contentId is number
            && request.resource.data.payload.contentType in ['movie', 'tv']
            && request.resource.data.payload.rating is number
            && request.resource.data.payload.rating >= 1
            && request.resource.data.payload.rating <= 10
          )
          || (
            request.resource.data.type == 'moderation_report'
            && request.resource.data.payload.reporterId == request.auth.uid
          )
          || (
            request.resource.data.type == 'social_notify'
            && hasString(request.resource.data.payload.recipientId)
            && hasString(request.resource.data.payload.title)
            && hasString(request.resource.data.payload.message)
            && request.resource.data.payload.type in [
              'friend_request', 'friend_accepted', 'watch_party_invite', 'watch_party_invite_declined', 'follow'
            ]
            && request.resource.data.requestedBy != request.resource.data.payload.recipientId
            && request.resource.data.payload.keys().hasOnly(['recipientId', 'type', 'title', 'message', 'senderName', 'data'])
            && (
              (
                request.resource.data.payload.type == 'friend_request'
                && request.resource.data.payload.data.from_user_id == request.auth.uid
                && request.resource.data.payload.data.friend_request_id is string
                && exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.payload.data.friend_request_id))
                && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.payload.data.friend_request_id)).data.fromUserId == request.auth.uid
                && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.payload.data.friend_request_id)).data.toUserId == request.resource.data.payload.recipientId
              )
              || (
                request.resource.data.payload.type == 'friend_accepted'
                && request.resource.data.payload.data.from_user_id == request.auth.uid
                && exists(/databases/$(database)/documents/friendships/$(request.resource.data.payload.data.friendship_id))
                && request.auth.uid in get(/databases/$(database)/documents/friendships/$(request.resource.data.payload.data.friendship_id)).data.users
                && request.resource.data.payload.recipientId in get(/databases/$(database)/documents/friendships/$(request.resource.data.payload.data.friendship_id)).data.users
              )
              || (
                request.resource.data.payload.type == 'watch_party_invite'
                && request.resource.data.payload.data.from_user_id == request.auth.uid
                && request.resource.data.payload.data.invite_id is string
                && exists(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.invite_id))
                && get(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.invite_id)).data.fromUserId == request.auth.uid
                && get(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.invite_id)).data.toUserId == request.resource.data.payload.recipientId
              )
              || (
                request.resource.data.payload.type == 'watch_party_invite_declined'
                && request.resource.data.payload.data.from_user_id == request.auth.uid
                && request.resource.data.payload.data.room_id is string
                && exists(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.room_id + '_' + request.auth.uid))
                && get(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.room_id + '_' + request.auth.uid)).data.toUserId == request.auth.uid
                && get(/databases/$(database)/documents/watch_party_invites/$(request.resource.data.payload.data.room_id + '_' + request.auth.uid)).data.fromUserId == request.resource.data.payload.recipientId
              )
              || (
                request.resource.data.payload.type == 'follow'
                && request.resource.data.payload.data.from_user_id == request.auth.uid
                && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.payload.recipientId))
              )
            )
          )
        );
      allow read, update, delete: if false;
    }

    // ── Moderation queue — Cloud Functions only
    match /moderation_queue/{docId} {
      allow read, write: if false;
    }

    // Stripe webhook idempotency — server-only via Admin SDK
    match /stripe_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // ── User settings (player prefs, synced across devices) ───
    match /user_settings/{userId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── Presence (online/offline status) ────────────────────────
    match /presence/{userId} {
      // Users can read anyone's presence status
      allow read: if isAuthenticated();
      // Users can only write their own presence
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.status in ['online', 'offline']
        && request.resource.data.lastSeen is number
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // ── Member profiles (multi-profile picker) ─────────────────
    match /member_profiles/{profileId} {
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.displayName is string
        && request.resource.data.type in ['standard', 'kids'];
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId
        && request.auth.uid == request.resource.data.ownerId;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
    }

    // ── Watch Parties ─────────────────────────────────────────
    match /watch_parties/{roomId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.hostId
        && request.resource.data.participants == [request.auth.uid];
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.hostId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.status == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
        || (
          request.auth.uid in resource.data.participants
          && request.auth.uid != resource.data.hostId
          && !(request.auth.uid in request.resource.data.participants)
          && resource.data.participants.hasAll(request.resource.data.participants)
          && request.resource.data.participants.size() == resource.data.participants.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        )
      );
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.hostId;
    }

    // ── Watch Party Invites ───────────────────────────────────
    match /watch_party_invites/{inviteId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId is string
        && request.auth.uid != request.resource.data.toUserId
        && request.resource.data.roomId is string
        && (
          (exists(/databases/$(database)/documents/flix_parties/$(request.resource.data.roomId))
            && request.auth.uid in get(/databases/$(database)/documents/flix_parties/$(request.resource.data.roomId)).data.participantIds)
          ||
          (exists(/databases/$(database)/documents/watch_parties/$(request.resource.data.roomId))
            && request.auth.uid in get(/databases/$(database)/documents/watch_parties/$(request.resource.data.roomId)).data.participants)
        );
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.toUserId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.respondedAt is number
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt']);
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow update: if false;
    }
  }
}
