    "test:webhook": "vitest run e2e/webhook-idempotency.test.ts",
    "test:rules": "node scripts/validate-firestore-rules.mjs",
    "worker:jobs": "python scripts/python/process_jobs.py --once",
    "worker:reports": "python scripts/python/process_reports.py"
  },
