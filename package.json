  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "lint": "eslint .",
    "check:public-env": "node scripts/check-public-env.mjs",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "test": "vitest run",
